                      "content": "FULL TEAM"
                    },
                    "DPKQD": {
                      "content": "Players and coaches travel as a group. ESP coordinates the European side of the experience. Parents can join individually through optional companion packages."
                    }
                  }
                }
              ]
            },
            {
              "type": "text",
              "id": "JzFod",
