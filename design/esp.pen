                },
                {
                  "type": "text",
                  "id": "UbSoD",
                  "name": "Para 1",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Valencia is one of Spain's most dynamic cities — a place where futuristic architecture meets a 2,000-year-old old town, where the Mediterranean beach is minutes from the historic centre, and where paella was invented. The City of Arts and Sciences, the Turia gardens and the vibrant Ruzafa neighbourhood give players a rich urban experience.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "JxgDB",
                  "name": "Para 2",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Valencia's football culture runs deep, and the Mediterranean lifestyle makes it one of Europe's most liveable cities. Players experience warm weather, outdoor life and a food culture that is central to Valencian identity — from the markets to the beachfront rice restaurants.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
