                {
                  "type": "text",
                  "id": "Hnbco",
                  "name": "H2",
                  "fill": "$navy",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "OVIEDO &\nASTURIAS",
                  "lineHeight": 1.08,
                  "fontFamily": "Playfair Display",
                  "fontSize": 48,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "XHK3Q",
                  "name": "Para 1",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Oviedo is one of northern Spain's most charming cities — a walkable old town anchored by a stunning Gothic cathedral, surrounded by the green mountains of Asturias. The region is famous for its cider culture, hearty cuisine and a way of life shaped by nature.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "PPqVy",
                  "name": "Para 2",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Asturias has a proud football tradition and a passionate local culture. Players experience a side of Spain that most visitors never see — mountain landscapes, pre-Romanesque architecture and communities where football is woven into daily life.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
