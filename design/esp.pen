                {
                  "type": "text",
                  "id": "UYGs5",
                  "name": "H2",
                  "fill": "$navy",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "SAN SEBASTIÁN &\nTHE BASQUE COUNTRY",
                  "lineHeight": 1.08,
                  "fontFamily": "Playfair Display",
                  "fontSize": 48,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "zTovY",
                  "name": "Para 1",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "San Sebastián is one of Europe's most beautiful coastal cities. La Concha beach, the atmospheric Old Town with its famous pintxos bars, and the green hills of the Basque Country create a setting unlike anywhere else in Spain. Players experience the city's unique culture, language and traditions throughout the week.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "H98Zii",
                  "name": "Para 2",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The Basque Country has its own deep football culture — one of the most passionate in Europe. From the local derbies to the atmosphere in the streets on matchday, players don't just train here. They live inside a football city.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
