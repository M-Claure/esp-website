                  "fill": "$navy",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "VALENCIA &\nTHE MEDITERRANEAN",
                  "lineHeight": 1.08,
                  "fontFamily": "Playfair Display",
                  "fontSize": 48,
