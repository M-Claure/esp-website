                {
                  "type": "text",
                  "id": "GDAEg",
                  "name": "H2",
                  "fill": "$navy",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "WHY SPORTING DE GIJÓN",
                  "lineHeight": 1.08,
                  "fontFamily": "Playfair Display",
                  "fontSize": 48,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "afL4p",
                  "name": "Para 1",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Real Sporting de Gijón is one of Spain's most storied clubs, with a football identity built on passion, community and a fierce competitive spirit. Mareo, the club's sports city, is one of the most complete training environments in Spanish football — a place where players live and train inside the club.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "KU6gw",
                  "name": "Para 2",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The Mareo methodology develops players in a competitive, high-intensity environment. The sports city combines training pitches, match facilities and residential spaces, creating a total-immersion experience that few clubs in Spain can offer.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "k4thS",
                  "name": "Para 3",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "ESP players train with Sporting's coaching staff at Mareo, experiencing life inside a professional club environment. The football program is complemented by Gijón's Atlantic coast, beach culture and the warmth of one of Spain's great football cities.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                }
              ]
            },
