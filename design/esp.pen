                  "name": "Para 2",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The academy develops players through a modern, technically demanding style. Training at Girona means experiencing first-team methodology — the same principles and intensity that drive the senior squad's success on the European stage.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
