                {
                  "type": "text",
                  "id": "AL3Q8",
                  "name": "H2",
                  "fill": "$navy",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A CORUÑA &\nGALICIA",
                  "lineHeight": 1.08,
                  "fontFamily": "Playfair Display",
                  "fontSize": 48,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "WwpOC",
                  "name": "Para 1",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A Coruña is an Atlantic city with a unique character — the Tower of Hercules (the world's oldest working lighthouse), a dramatic coastline, and a seafood culture that is among the finest in Europe. The city's glass-fronted galleries, vibrant plazas and Galician language give it an identity distinctly different from the rest of northern Spain.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "aZrSs",
                  "name": "Para 2",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Galicia has its own deep football culture and fierce local pride. Depor's blue-and-white stripes represent a city that has always punched above its weight — on the pitch and off it. Players experience an Atlantic, Celtic-influenced corner of Spain that feels like nowhere else.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
