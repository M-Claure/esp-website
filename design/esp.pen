                {
                  "type": "text",
                  "id": "aOnPE",
                  "name": "H2",
                  "fill": "$navy",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "WHY DEPORTIVO",
                  "lineHeight": 1.08,
                  "fontFamily": "Playfair Display",
                  "fontSize": 48,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "Haey3",
                  "name": "Para 1",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Deportivo de La Coruña is a club with one of Spanish football's most passionate histories. Based at the Abegondo training center, Depor has built a development culture — the Método Dépor — rooted in technical quality, tactical intelligence and the resilience that defines the club's identity.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "lQz9J",
                  "name": "Para 2",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The Método Dépor is a comprehensive player development framework that emphasises technical skill under pressure, positional understanding and competitive mentality. The coaching staff bring deep experience from one of Spain's most committed academy systems.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "AfUsA",
                  "name": "Para 3",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "ESP players train with Deportivo's coaching staff at Abegondo, following the Método Dépor development pathway. The football experience is paired with the extraordinary Atlantic coast, Galician culture and the passionate football city of A Coruña.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                }
              ]
            },
