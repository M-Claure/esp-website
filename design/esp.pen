                    }
                  }
                },
                {
                  "type": "text",
                  "id": "b2GA6W",
                  "name": "H2",
                  "fill": "$navy",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "WHY REAL SOCIEDAD",
                  "lineHeight": 1.08,
                  "fontFamily": "Playfair Display",
                  "fontSize": 48,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "v25hVa",
                  "name": "Para 1",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Real Sociedad is one of Spanish football's most respected development clubs. Based at the Zubieta training center in the hills above San Sebastián, the club has built a culture rooted in discipline, talent identification and player development that consistently produces top-level talent.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "B8Zef",
                  "name": "Para 2",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The academy methodology emphasizes technical excellence, tactical understanding and competitive readiness. Players who train at Zubieta experience the same environment and philosophy that shapes the club's professional squads.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "wOy9O",
                  "name": "Para 3",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "ESP players work with Real Sociedad's academy coaching staff, using the club's world-class facilities and following their established development methodology. The football experience is paired with the extraordinary city and culture of San Sebastián and the Basque Country.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                }
              ]
            },
