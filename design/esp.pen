                {
                  "type": "text",
                  "id": "x63EIE",
                  "name": "H2",
                  "fill": "$navy",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "WHY RACING DE SANTANDER",
                  "lineHeight": 1.08,
                  "fontFamily": "Playfair Display",
                  "fontSize": 48,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "OHY0n",
                  "name": "Para 1",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Racing de Santander is a club defined by character, community and a deep connection to Cantabria. Based at the Nando Yosu sports city in La Albericia, Racing has a proud footballing history and a development culture shaped by resilience and competitive pride.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "ozfHf",
                  "name": "Para 2",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The coaching staff focus on player development through competitive intensity, tactical awareness and technical progression. Training at Nando Yosu gives players access to a professional environment with a strong sense of club identity and local football tradition.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "s0v7d",
                  "name": "Para 3",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "ESP players train with Racing's coaching staff at Nando Yosu, following the club's player development approach. The football experience is paired with one of Spain's most beautiful coastal settings — Santander's bays, beaches and the mountains of Cantabria.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                }
              ]
