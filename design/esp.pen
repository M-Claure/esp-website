                {
                  "type": "text",
                  "id": "QRI1C",
                  "name": "H2",
                  "fill": "$navy",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "GIJÓN &\nTHE ASTURIAN COAST",
                  "lineHeight": 1.08,
                  "fontFamily": "Playfair Display",
                  "fontSize": 48,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "VvjWF",
                  "name": "Para 1",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Gijón is a vibrant Atlantic city defined by its coastline, its people and its football. San Lorenzo beach stretches along the heart of the city, and the old fishing quarter of Cimadevilla sits on a headland between the sea and the port. The city's sidra (cider) culture and seafood traditions are central to daily life.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "wfceE",
                  "name": "Para 2",
                  "fill": "$slate",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Sporting's red-and-white stripes are everywhere in Gijón — this is a true football city where the club and the community are inseparable. Players experience a passionate, welcoming culture rooted in Asturian identity and pride.",
                  "lineHeight": 1.6,
                  "fontFamily": "Source Sans 3",
                  "fontSize": 18,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
