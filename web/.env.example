# Form submissions (the /apply and /teams forms).
# Copy to .env.local for local dev. In production these live in Vercel → Project → Settings → Environment Variables.
# Setup walkthrough: ../docs/FORM_SUBMISSIONS.md
#
# Leave everything empty and submissions are just printed to the terminal — handy while developing.

# --- Google Sheet (one row per submission) ---
# Web app URL from Apps Script → Deploy → Manage deployments (ends in /exec)
GOOGLE_SHEET_WEBHOOK_URL=
# Must match the WEBHOOK_SECRET script property in Apps Script. Generate one: openssl rand -hex 24
GOOGLE_SHEET_WEBHOOK_SECRET=
# Optional: the sheet's normal browser URL, linked from the team notification email
GOOGLE_SHEET_URL=

# --- Email via Resend (confirmation to the applicant + notification to the team) ---
RESEND_API_KEY=
# Must be on a domain verified in Resend. Display name is optional.
EMAIL_FROM="Euro Soccer Passport <hello@eurosoccerpassport.com>"
# Who gets the "someone just submitted" email. Comma-separate for more than one.
EMAIL_TEAM_INBOX=
# Optional: where replies to the applicant's confirmation go. Defaults to the first EMAIL_TEAM_INBOX address.
EMAIL_REPLY_TO=

# Optional: used for links in emails. Defaults to https://eurosoccerpassport.com
NEXT_PUBLIC_SITE_URL=
